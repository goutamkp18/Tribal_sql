# TribalSQL Environment Configuration
# Designed for seamless transition from Simulated Mock Mode to FastAPI + PostgreSQL + Hindsight Backend

# Backend Mode: Set to false to connect to FastAPI backend
VITE_USE_MOCK_API=true

# FastAPI Base URL
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Demo Workspace
VITE_DEFAULT_WORKSPACE=NovaMart

# LLM Inference Provider
VITE_GROQ_MODEL=qwen-2.5-coder-32b

# Hindsight Cloud Cluster
VITE_HINDSIGHT_CLUSTER_URL=https://cluster-4.hindsight.cloud
VITE_HINDSIGHT_NAMESPACE=novamart_production_v2

